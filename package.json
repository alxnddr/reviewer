{
  "name": "reviewer",
  "version": "0.1.0",
  "private": true,
  "description": "Local-first desktop diff viewer with high-fidelity rendering, agent-authored reviews, and semantic layers",
  "license": "MIT",
  "author": "Aleksandr Lesnenko",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "cli": "bun cli/index.ts",
    "build:cli": "bun build cli/index.ts --target=node --outfile dist/rvw.js && printf '{\"type\":\"module\"}\\n' > dist/package.json",
    "start": "electron-vite preview",
    "build": "electron-vite build",
    "build:mac": "bun run build:cli && electron-vite build && electron-builder --mac",
    "postinstall": "electron-builder install-app-deps",
    "gen:icon": "node scripts/gen-icon.mjs",
    "typecheck": "tsgo --noEmit -p tsconfig.node.json && tsgo --noEmit -p tsconfig.web.json && tsgo --noEmit -p tsconfig.tools.json",
    "typecheck:slow": "tsc --noEmit -p tsconfig.node.json --composite false && tsc --noEmit -p tsconfig.web.json --composite false",
    "lint": "oxlint .",
    "fmt": "oxfmt .",
    "fmt:check": "oxfmt --check .",
    "check": "bun run typecheck && bun run lint && bun run fmt:check",
    "test": "vitest run"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@electron-toolkit/utils": "^4.0.0",
    "@fontsource-variable/geist": "^5.2.9",
    "@fontsource-variable/geist-mono": "^5.2.8",
    "@pierre/diffs": "^1.3.0-beta.7",
    "@pierre/trees": "^1.0.0-beta.5",
    "@stricli/core": "^1.2.9",
    "@tailwindcss/vite": "^4.3.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "electron-store": "^11.0.2",
    "lucide-react": "^1.23.0",
    "react-resizable-panels": "^4.12.1",
    "shadcn": "^4.13.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.2",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.0.0",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@types/node": "^22.19.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@typescript/native-preview": "latest",
    "@vitejs/plugin-react": "^5.1.1",
    "ajv": "^8.20.0",
    "electron": "^43.0.0",
    "electron-builder": "^26.0.12",
    "electron-vite": "^5.0.0",
    "oxfmt": "latest",
    "oxlint": "latest",
    "playwright": "^1.61.1",
    "playwright-core": "^1.61.1",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "typescript": "^5.9.3",
    "vite": "^7.2.6",
    "vitest": "^3.0.0"
  }
}
